# ============================================================
# OrbitGuard AI — Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and must NEVER be committed.
# ============================================================

# ---- IBM watsonx / Granite AI (all four required to enable Granite) ----
# Obtain from: https://cloud.ibm.com/apidocs/watsonx-ai
# If any value is missing, OrbitGuard falls back to Demo AI automatically.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL_ID=ibm/granite-3-8b-instruct

# Available regions for WATSONX_URL:
#   https://us-south.ml.cloud.ibm.com
#   https://eu-de.ml.cloud.ibm.com
#   https://eu-gb.ml.cloud.ibm.com
#   https://au-syd.ml.cloud.ibm.com
#   https://jp-tok.ml.cloud.ibm.com

# Available models for GRANITE_MODEL_ID:
#   ibm/granite-3-8b-instruct   (recommended)
#   ibm/granite-3-2b-instruct   (faster, lower cost)
#   ibm/granite-13b-instruct-v2 (higher quality)

# ---- Database (PostgreSQL / Supabase) ----
# Leave blank to run in-memory demo mode (no data persistence)
DATABASE_URL=

# Supabase example:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ---- Vector Database ----
# Supports: pgvector (via DATABASE_URL), pinecone, weaviate, demo
# Leave blank or set to 'demo' for keyword-search fallback
VECTOR_DB_TYPE=demo
PINECONE_API_KEY=
WEAVIATE_URL=

# ---- Python Anomaly Detection Service ----
# Run: cd services/anomaly_detection && pip install -r requirements.txt && python server.py
# Leave blank to use the built-in TypeScript anomaly detection
ANOMALY_SERVICE_URL=

# ---- Space Data APIs (optional) ----
# N2YO for real satellite tracking: https://www.n2yo.com/api/
# Register for a free API key at https://www.n2yo.com/login/register/
# Leave blank — the app runs fully in simulation mode without this key.
# This key is read server-side only and is NEVER exposed to the browser.
N2YO_API_KEY=

# Orbital data mode (server-only — intentionally NOT prefixed NEXT_PUBLIC_):
#   simulation  — static reference positions, no external API calls (default, safe)
#   live        — real-time N2YO positions; automatically falls back to simulation
#                 if N2YO_API_KEY is missing or the request fails
# Response data_source field values:
#   'simulated' — simulation mode active
#   'n2yo'      — live N2YO data returned successfully
#   'fallback'  — live mode requested but N2YO failed; simulation used
ORBITAL_DATA_MODE=simulation

# ---- App Config ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Legacy data mode for dashboard/telemetry pipeline (not used for orbital tracking):
NEXT_PUBLIC_DATA_MODE=simulation

# ---- Feature Flags ----
NEXT_PUBLIC_ENABLE_VECTOR_SEARCH=false
NEXT_PUBLIC_ENABLE_REAL_TELEMETRY=false

# ---- Supabase Authentication ----
# Get these from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<YOUR-PROJECT-REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<YOUR-SUPABASE-ANON-KEY>
